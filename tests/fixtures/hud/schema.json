{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis-companion/hud.schema.json",
  "title": "Jarvis HUD message",
  "type": "object",
  "properties": {
    "shapes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shape"
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "required": [
    "shapes",
    "cards"
  ],
  "$defs": {
    "shape": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "rect",
            "circle",
            "triangle"
          ]
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "box"
      ],
      "additionalProperties": false
    },
    "card": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "info"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "body": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "minItems": 1,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "stat"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "value": {
              "type": "string",
              "maxLength": 24
            },
            "label": {
              "type": "string",
              "maxLength": 40
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "value",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bar"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "caption": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "flow"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 60
                  }
                },
                "required": [
                  "id",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 3
              }
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "link"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "source": {
              "type": "string",
              "maxLength": 60
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "alt": {
              "type": "string",
              "maxLength": 120
            },
            "caption": {
              "type": "string",
              "maxLength": 120
            },
            "source_page": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "source_page": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "file_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          "required": [
            "id",
            "type",
            "title"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "file_id"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "video"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "youtube_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "thumbnail_url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "source_page": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "required": [
            "id",
            "type",
            "title"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "youtube_id"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "web"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "page": {
              "enum": [
                "map",
                "drawing",
                "model"
              ]
            },
            "data": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "routes": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "points": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 300,
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 2,
                              "maxItems": 2
                            }
                          },
                          "km": {
                            "type": "number",
                            "minimum": 0
                          },
                          "min": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "points",
                          "km",
                          "min"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "pins": {
                      "type": "array",
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "properties": {
                          "lat": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          "lon": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 40
                          }
                        },
                        "required": [
                          "lat",
                          "lon",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "attribution": {
                      "const": "© OpenStreetMap contributors"
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 5,
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "maxLength": 40,
                            "minLength": 1
                          },
                          "road": {
                            "type": "string",
                            "maxLength": 40
                          },
                          "min": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 600
                          },
                          "mode": {
                            "enum": [
                              "walk",
                              "bus",
                              "tube",
                              "train"
                            ]
                          },
                          "km": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 50
                          },
                          "hours": {
                            "type": "string",
                            "pattern": "^(?:open 24 hours|closed now|hours not listed|open until (?:midnight|(?:[01]\\d|2[0-3]):[0-5]\\d))$"
                          },
                          "times": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 3,
                            "items": {
                              "type": "object",
                              "properties": {
                                "at": {
                                  "type": "string",
                                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                                },
                                "film": {
                                  "type": "string",
                                  "maxLength": 40
                                }
                              },
                              "required": [
                                "at",
                                "film"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "note": {
                            "enum": [
                              "times_not_listed",
                              "none",
                              "none_tomorrow"
                            ]
                          }
                        },
                        "required": [
                          "name",
                          "km"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "credits": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 3,
                      "items": {
                        "enum": [
                          "osm",
                          "tfl",
                          "clusterflick"
                        ]
                      }
                    },
                    "asof": {
                      "type": "string",
                      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                    }
                  },
                  "required": [
                    "routes",
                    "pins",
                    "attribution"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "svg": {
                      "type": "string",
                      "maxLength": 48000
                    },
                    "legend": {
                      "type": "array",
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  },
                  "required": [
                    "svg",
                    "legend"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                    },
                    "view": {
                      "enum": [
                        "model",
                        "preview"
                      ]
                    }
                  },
                  "required": [
                    "slug",
                    "view"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "page",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "chart"
            },
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "chart": {
              "enum": [
                "pie",
                "donut",
                "line",
                "area",
                "bar",
                "stacked_bar",
                "scatter",
                "gauge"
              ]
            },
            "labels": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 24
              }
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "values": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "values"
                ],
                "additionalProperties": false
              }
            },
            "unit": {
              "type": "string",
              "maxLength": 12
            },
            "caption": {
              "type": "string",
              "maxLength": 120
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "chart",
            "series"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

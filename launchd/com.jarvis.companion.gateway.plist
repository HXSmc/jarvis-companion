<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jarvis.companion.gateway</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/<user>/Desktop/personal/jarvis-companion/.venv/bin/uvicorn</string>
		<string>gateway.app:app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8788</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/<user>/Desktop/personal/jarvis-companion</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>

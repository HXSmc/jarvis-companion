<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jarvis.companion.altstore-http</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-m</string>
		<string>http.server</string>
		<string>8446</string>
		<string>--bind</string>
		<string>127.0.0.1</string>
		<string>--directory</string>
		<string>/Users/<user>/Library/Application Support/jarvis-companion/altstore</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/<user>/Library/Logs/jarvis-altstore-http.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/<user>/Library/Logs/jarvis-altstore-http.log</string>
</dict>
</plist>

#!/usr/bin/env python3
"""jarvis-overlay-log — the last overlay turns, redacted, in a terminal.

Usage:
  jarvis-overlay-log [--since 10m] [--json]

--since keeps turns newer than Ns|Nm|Nh (plain digits = seconds).
Reads http://127.0.0.1:$JARVIS_GATEWAY_PORT/overlay-log with the ios_token;
the token is never printed.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import httpx  # noqa: E402

from common import config  # noqa: E402

SINCE_RE = re.compile(r"^(\d+)([smh]?)$")
UNITS = {"": 1, "s": 1, "m": 60, "h": 3600}


def _since(text: str) -> int:
    match = SINCE_RE.match(text)
    if not match:
        raise argparse.ArgumentTypeError("since is Ns|Nm|Nh or plain seconds (e.g. 10m)")
    return int(match.group(1)) * UNITS[match.group(2)]


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="last overlay turns, redacted")
    parser.add_argument("--since", type=_since, metavar="Ns|Nm|Nh",
                        help="only turns newer than this (default: whatever the gateway keeps)")
    parser.add_argument("--json", action="store_true", help="print the redacted JSON instead of one line per row")
    return parser


def _detail(row: dict) -> str:
    if row.get("step") == "agent_tool":
        text = " ".join(str(row[key]) for key in ("tool", "decision") if row.get(key))
    else:
        text = next((str(row[key]) for key in ("detail", "text", "reason", "kind") if row.get(key)), "")
    return text[:120]


def _line(row: dict) -> str:
    at = row.get("at")
    clock = time.strftime("%H:%M:%S", time.localtime(at)) if isinstance(at, (int, float)) else "??:??:??"
    return f"{clock}  {row.get('step', '?')}  {_detail(row)}"


def main(argv: list[str] | None = None, client: httpx.Client | None = None) -> int:
    args = _parser().parse_args(argv)
    token = config.get_token(name="ios_token")
    if not token:
        print("no ios_token configured", file=sys.stderr)
        return 2
    port = os.environ.get("JARVIS_GATEWAY_PORT", "8788")
    try:
        resp = (client or httpx.Client(timeout=httpx.Timeout(10.0, connect=5.0))).get(
            f"http://127.0.0.1:{port}/overlay-log",
            params={"since": args.since} if args.since is not None else None,
            headers={"Authorization": f"Bearer {token}"})
    except httpx.HTTPError as err:
        print(f"gateway unreachable: {type(err).__name__}", file=sys.stderr)
        return 1
    if resp.status_code != 200:
        print(f"gateway answered {resp.status_code}", file=sys.stderr)
        return 1
    payload = resp.json()
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    for turn in payload.get("turns") or []:
        for row in turn.get("steps") or []:
            print(_line(row))
    return 0


if __name__ == "__main__":
    sys.exit(main())

# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit it. The gateway loads it at import
# (common/config.py), and the shell scripts that need private values source
# it themselves.

# --- gateway: Mini PC upstreams (your tailscale serve URLs) ---
MINIPC_NOVNC_BASE=https://novnc.example.invalid:8802
MINIPC_VNC_WS=wss://novnc.example.invalid:8802/websockify

# --- gateway: optional overrides (neutral defaults if unset) ---
#JARVIS_DEFAULT_PROJECT=acme

# --- shortcuts/build_jarvis.py (gateway /siri/hey URL) ---
JARVIS_SHORTCUT_URL=https://gateway.example.invalid:8790/siri/hey

# --- scripts/altstore_publish.sh ---
JARVIS_ALTSTORE_HOST=altstore-host.example.invalid

# --- scripts/deliver_windows.sh (tailnet device name) ---
JARVIS_WINPC_TAILDROP=winpc-device-name

# --- scripts/hub/* (this checkout's absolute path) ---
JARVIS_REPO_DIR=$HOME/src/jarvis-companion

# --- scripts/vendor_watch.py ---
JARVIS_VENDOR_ACCOUNTS=first@example.invalid,second@example.invalid
# JSON mapping (keep the single quotes so shells source this file cleanly):
JARVIS_VENDOR_DOMAINS='{"vendor1.example.invalid": "Vendor1", "vendor2.example.invalid": "Vendor2"}'
#JARVIS_VENDOR_CONTEXT=$HOME/.jarvis/vendor-watch/context.md
#JARVIS_VENDOR_WATCH_RESUME=$HOME/.jarvis/vendor-watch/resume.md
